"""
cloudComPy is the Python module interfacing cloudCompare library.
Python3 access to cloudCompare objects is done like this:
::

  import cloudComPy as cc 
  cc.initCC()  # to do once before using plugins
  cloud = cc.loadPointCloud("/home/paul/CloudComPy/Data/boule.bin")
 
"""
import os
import sys
from pathlib import Path

cloudComPyInstallDir = os.path.dirname(__file__)
sys.path.append(os.path.join(cloudComPyInstallDir, "CloudCompare", "CloudCompare.app", "Contents", "Frameworks" ))
sys.path.append(os.path.join(cloudComPyInstallDir, "doc", "PythonAPI_test" ))

# ---------------------------------------------------------------------------
# 1. Localisation du dossier CloudCompare (racine de CloudComPy)
# ---------------------------------------------------------------------------
# _this_dir = Path(__file__).resolve().parent
# print(_this_dir)
# _cc_root = _this_dir.parent  # CloudCompare/
# print(_cc_root)
# _cc_plugins = _cc_root / "plugins"
# print(_cc_plugins)

# ---------------------------------------------------------------------------
# 4. Plugins Qt
# ---------------------------------------------------------------------------
os.environ["QT_PLUGIN_PATH"] = os.path.join(os.path.dirname(__file__), "CloudCompare", "CloudCompare.app", "Contents", "plugins")
os.environ["QT_QPA_PLATFORM_PLUGIN_PATH"] = os.path.join(os.path.dirname(__file__), "CloudCompare", "CloudCompare.app", "Contents", "plugins", "platforms")

# ---------------------------------------------------------------------------
# 5. Import du module natif CloudComPy
# ---------------------------------------------------------------------------
# automatic detection: PyPI build if module in site-packages
is_in_site_packages = "site-packages" in cloudComPyInstallDir
isPypiBuild = int(is_in_site_packages)

if isPypiBuild:
    from _cloudComPy import *
else:
    from _cloudComPy import *

initCC()
initCloudCompare()

def launchCloudCompareGUI():
    """
    Launch the CloudCompare GUI in a subprocess, and return immediately.
    """
    import subprocess
    subprocess.Popen(os.path.join(cloudComPyInstallDir, "CloudCompare", "CloudCompare.app", "Contents", "MacOS", "CloudCompare"))
    
def launchTests():
    """
    Launch the cloudComPy Python tests
    """
    import subprocess
    oldCWD = os.getcwd()
    os.chdir(os.path.join(cloudComPyInstallDir, "doc", "PythonAPI_test"))
    subprocess.run("ctest")
    os.chdir(oldCWD)

def launchDoc():
    """
    Launch the cloudComPy documentation in a web browser.
    """
    import webbrowser
    doc = Path(cloudComPyInstallDir) / "doc" / "html" / "index.html"
    webbrowser.open(doc.resolve().as_uri())
