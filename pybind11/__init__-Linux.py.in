"""
cloudComPy is the Python module interfacing cloudCompare library.
Python3 access to cloudCompare objects is done like this:
::

  import cloudComPy as cc 
  cc.initCC()  # to do once before using plugins
  cloud = cc.loadPointCloud("/home/paul/CloudComPy/Data/boule.bin")
 
"""
import os
import sys
from pathlib import Path

cloudComPyInstallDir = os.path.dirname(__file__)
sys.path.append(os.path.join(cloudComPyInstallDir, "doc", "PythonAPI_test"))
if "LD_LIBRARY_PATH" in os.environ:
    libpath=os.environ["LD_LIBRARY_PATH"].split(':')
    if cloudComPyInstallDir not in libpath:
        os.environ["LD_LIBRARY_PATH"]=cloudcompyInstallDir + ':' + os.environ["LD_LIBRARY_PATH"]
else:
    os.environ["LD_LIBRARY_PATH"]=cloudComPyInstallDir

# automatic detection: PyPI build if module in site-packages
is_in_site_packages = "site-packages" in cloudComPyInstallDir
isPypiBuild = int(is_in_site_packages)

if isPypiBuild:
    os.environ["QT_PLUGIN_PATH"]=os.path.join(cloudComPyInstallDir, "plugins")
    #print("QT_PLUGIN_PATH", os.environ["QT_PLUGIN_PATH"])
    os.environ["QT_QPA_PLATFORM_PLUGIN_PATH"]=os.path.join(cloudComPyInstallDir, "plugins", "platforms")
    #print("QT_QPA_PLATFORM_PLUGIN_PATH", os.environ["QT_QPA_PLATFORM_PLUGIN_PATH"])
    os.environ.setdefault("FONTCONFIG_FILE", "/etc/fonts/fonts.conf")
    os.environ.setdefault("FONTCONFIG_PATH", "/etc/fonts")

    from ._cloudComPy import *
else:
    from _cloudComPy import *


initCC()
initCloudCompare()

def launchCloudCompareGUI():
    """
    Launch the CloudCompare GUI in a subprocess, and return immediately.
    """
    import subprocess
    subprocess.Popen(os.path.join(cloudComPyInstallDir, "CloudCompare"))
    
def launchTests():
    """
    Launch the cloudComPy Python tests
    """
    import subprocess
    oldCWD = os.getcwd()
    os.chdir(os.path.join(cloudComPyInstallDir,"doc/PythonAPI_test"))
    subprocess.run("ctest")
    os.chdir(oldCWD)

def launchDoc():
    """
    Launch the cloudComPy documentation in a web browser.
    """
    import webbrowser
    webbrowser.open(os.path.join(cloudComPyInstallDir,"doc/html/index.html"))
